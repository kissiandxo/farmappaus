# Copy to .env (local) or set as EAS environment variables (builds).
# Leave both empty to run as a free directory of the built-in places, with no accounts.
# Supabase dashboard > Project Settings > API. The anon key is public by design.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Where "Contact us", "Suggest a place", "Report a problem" and "Is this your place?" send email.
# Leave empty to hide those rows. In CI this comes from the repository variable SUPPORT_EMAIL.
EXPO_PUBLIC_SUPPORT_EMAIL=
