# Builds the iOS app on a GitHub macOS runner and uploads it to TestFlight.
# Used by .github/workflows/testflight.yml. No Mac or Expo account needed.
default_platform(:ios)

platform :ios do
  lane :beta do
    setup_ci # temporary keychain on the CI machine

    key = ENV.fetch("ASC_KEY_P8")
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: key,
      # Accept the .p8 text as-is, or base64 of it.
      is_key_content_base64: !key.include?("BEGIN PRIVATE KEY")
    )

    # Distribution certificate + App Store provisioning profile, via the API key.
    get_certificates(api_key: api_key)
    get_provisioning_profile(api_key: api_key, app_identifier: "au.farmdirect.app", force: true)
    profile = lane_context[SharedValues::SIGH_NAME]

    update_code_signing_settings(
      path: "ios/FarmDirect.xcodeproj",
      use_automatic_signing: false,
      team_id: "JAFHQKKHVK",
      code_sign_identity: "Apple Distribution",
      profile_name: profile,
      bundle_identifier: "au.farmdirect.app",
      targets: ["FarmDirect"]
    )

    increment_build_number(xcodeproj: "ios/FarmDirect.xcodeproj", build_number: ENV.fetch("BUILD_NUMBER"))

    build_app(
      workspace: "ios/FarmDirect.xcworkspace",
      scheme: "FarmDirect",
      export_method: "app-store",
      export_options: { provisioningProfiles: { "au.farmdirect.app" => profile } }
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
